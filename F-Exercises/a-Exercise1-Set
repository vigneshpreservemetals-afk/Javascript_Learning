

// Example 1 - RemoveDuplicateValues using Set

let FruitsList = ["apple","Orange","Orange","apple","Mango","Kiwi"];

let UpdatedFruitsList = new Set(FruitsList)

let UpdatedSet = [...UpdatedFruitsList]

