// Example 2 - RemoveDuplicateValues using Filter

let NewFruitsList = ["apple","Orange","Orange","apple","Mango","Kiwi"];

let RemoveDuplicateFruits = NewFruitsList.filter(
    (value,index,Arr) => {
    return Arr.indexOf(value) == index
    }

)

console.log("RemoveDuplicateFruits===>", RemoveDuplicateFruits)
